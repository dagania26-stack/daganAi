generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum SecurityEventType {
  RATE_LIMIT
  FAILED_AUTH
  SUSPICIOUS
  BRUTE_FORCE
}

// ─── Auth (NextAuth / Auth.js v5) ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  pays          String?
  ville         String?
  lastIp        String?
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  businesses   Business[]
  chatLogs     ChatLog[]
  securityLogs SecurityLog[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String   // "REGISTER" | "RESET_PASSWORD"
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, type])
}

model PendingUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Logs admin ───────────────────────────────────────────────────────────────

model ChatLog {
  id        String   @id @default(cuid())
  userId    String?
  question  String   @db.Text
  mode      String   @default("rag") // "rag" | "claude-direct" | "error"
  erreur    String?  @db.Text
  success   Boolean  @default(true)
  latenceMs Int?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([success])
  @@index([userId])
  @@index([createdAt])
}

model SecurityLog {
  id        String            @id @default(cuid())
  type      SecurityEventType
  ip        String?
  userId    String?
  details   String?           @db.Text
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([ip])
  @@index([createdAt])
}

// ─── Documents ────────────────────────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  titre       String
  domaine     String
  sousDomaine String?
  source      String
  version     String   @default("1.0")
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks Chunk[]

  @@index([domaine])
  @@index([actif])
}

// ─── Chunks (fragments vectorisés) ───────────────────────────────────────────

model Chunk {
  id         String                     @id @default(cuid())
  contenu    String
  embedding  Unsupported("vector(1536)")
  position   Int
  tokenCount Int                        @default(0)
  documentId String
  createdAt  DateTime                   @default(now())

  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  messages MessageChunk[]

  @@index([documentId])
}

// ─── Conversations ────────────────────────────────────────────────────────────

model Conversation {
  id        String   @id @default(uuid())
  langue    String   @default("fr")
  domaine   String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([createdAt])
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model Message {
  id             String   @id @default(cuid())
  question       String
  reponse        String
  scoreRAG       Float?
  latenceMs      Int?
  conversationId String
  createdAt      DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chunks       MessageChunk[]

  @@index([conversationId])
  @@index([createdAt])
}

// ─── Table de jonction Message ↔ Chunk ───────────────────────────────────────

model MessageChunk {
  messageId  String
  chunkId    String
  scoreCosin Float

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   Chunk   @relation(fields: [chunkId],   references: [id], onDelete: Cascade)

  @@id([messageId, chunkId])
}

// ─── Dagan Gestion — Module financier ────────────────────────────────────────

model Business {
  id                  String    @id @default(cuid())
  nom                 String
  secteur             String?
  pays                String    @default("TG")
  devise              String    @default("FCFA")
  userId              String?
  rapportFrequence    String?
  rapportDernierEnvoi DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User?             @relation(fields: [userId], references: [id])
  categories   Category[]
  products     Product[]
  transactions Transaction[]
  charges      Charge[]
  debts        Debt[]
  reports      FinancialReport[]

  @@index([userId])
  @@index([createdAt])
}

model Category {
  id         String @id @default(cuid())
  nom        String
  type       String
  businessId String

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products     Product[]
  transactions Transaction[]

  @@index([businessId])
}

model Product {
  id          String   @id @default(cuid())
  nom         String
  prixVente   Float
  coutRevient Float    @default(0)
  unite       String   @default("unité")
  actif       Boolean  @default(true)
  categoryId  String?
  businessId  String
  createdAt   DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([businessId])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  montant     Float
  description String?
  quantite    Float    @default(1)
  date        DateTime @default(now())
  businessId  String
  categoryId  String?
  productId   String?
  createdAt   DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  product  Product?  @relation(fields: [productId],  references: [id])

  @@index([businessId, date])
  @@index([businessId, type])
}

model Charge {
  id         String   @id @default(cuid())
  nom        String
  montant    Float
  type       String
  frequence  String   @default("MENSUEL")
  actif      Boolean  @default(true)
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Debt {
  id             String    @id @default(cuid())
  description    String
  montant        Float
  montantRestant Float
  creancier      String
  dateEcheance   DateTime?
  statut         String    @default("EN_COURS")
  businessId     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model FinancialReport {
  id          String   @id @default(cuid())
  periode     String
  dateDebut   DateTime
  dateFin     DateTime
  contenu     String   @db.Text
  kpiSnapshot Json
  businessId  String
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
