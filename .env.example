# Base de données PostgreSQL
DATABASE_URL=
DIRECT_URL=

# Clés API IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Service RAG (Python backend)
RAG_SERVICE_URL=http://localhost:8000

# Application
NEXT_PUBLIC_APP_NAME=Dagan IA

# SEO / Google Search Console — code de vérification (balise meta)
GOOGLE_SITE_VERIFICATION=

# Auth (NextAuth / Auth.js v5)
# Générer avec : openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (https://resend.com)
# Domaine vérifié requis en production (ex: no-reply@dagania.tech)
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO_EMAIL=

# RAG — clé partagée avec le service Render (doit être identique des deux côtés)
INGEST_SECRET=
